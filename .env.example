# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it is gitignored.

# Better Auth
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 | Production: https://your-client-domain.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# MongoDB credentials used by Better Auth (cluster0.4dwew1j.mongodb.net)
BETTER_AUTH_USERNAME_URL=
BETTER_AUTH_PASSWORD_URL=

# Google OAuth (Google Cloud Console credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployed Express backend URL (no trailing slash)
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:5000

# imgbb API key for image uploads
NEXT_PUBLIC_IMAGEBB_API_KEY=
